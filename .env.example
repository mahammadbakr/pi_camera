# Required — same value as the Gawdary server API_TOKEN
API_TOKEN=change-me-to-a-long-random-token

# Optional (defaults shown)
# GAWDARY_URL=https://gawdary-server.onrender.com
# CAPTURE_INTERVAL_MS=8000
# CAPTURE_DIR=/tmp/pi-camera
# RPICAM_BIN=rpicam-still
# RPICAM_VID_BIN=rpicam-vid
# IMAGE_WIDTH=1920
# IMAGE_HEIGHT=1080
# IMAGE_QUALITY=90
# LIVE_ENABLED=false
# LIVE_WIDTH=640
# LIVE_HEIGHT=480
# LIVE_FPS=5
# LIVE_PUSH_EVERY=1
# PORT=3080

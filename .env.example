# Gawdary API (same API_TOKEN as the gawdary server .env)
GAWDARY_URL=https://gawdary-server.onrender.com
API_TOKEN=change-me-to-a-long-random-token

# Capture schedule (default: 5 minutes)
CAPTURE_INTERVAL_MS=300000

# Local capture output
CAPTURE_DIR=/tmp/pi-camera
RPICAM_BIN=rpicam-still
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080
IMAGE_QUALITY=90

# Local health server
PORT=3080
